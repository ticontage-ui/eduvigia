POSTGRES_DB=eduvigia
POSTGRES_USER=eduvigia
POSTGRES_PASSWORD=ALTERE_PARA_UMA_SENHA_FORTE
DATABASE_URL=postgresql+psycopg://eduvigia:ALTERE_PARA_UMA_SENHA_FORTE@postgres:5432/eduvigia
REDIS_URL=redis://redis:6379/0

APP_ENV=development
APP_VERSION=2.0.0-F7-R3
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5177,http://127.0.0.1:5177,http://localhost:8088,https://localhost:18443
EDUVIGIA_SEED_DEMO_DATA=false
EDUVIGIA_BOOTSTRAP_ADMIN_EMAIL=admin@eduvigia.local
EDUVIGIA_BOOTSTRAP_ADMIN_PASSWORD=ALTERE_PARA_UMA_SENHA_FORTE

# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EDUVIGIA_CREDENTIAL_KEY=
EDUVIGIA_EVENT_INGEST_KEY=

# Chave HMAC exclusiva para autorizações temporárias de vídeo (mínimo 32 caracteres).
EDUVIGIA_STREAM_SIGNING_KEY=
EDUVIGIA_STREAM_TOKEN_TTL_SECONDS=300
EDUVIGIA_WEBRTC_PUBLIC_PORT=18889
EDUVIGIA_HLS_PUBLIC_PORT=18888
EDUVIGIA_WEBRTC_PUBLIC_BASE=
EDUVIGIA_HLS_PUBLIC_BASE=
EDUVIGIA_MEDIA_PUBLIC_SCHEME=http
# DEV: HLS/WebRTC usam HTTP para evitar bloqueio por certificado autoassinado.
# PROD: docker-compose.prod.yml força HTTPS com mediamtx.prod.yml.
# Informe também o IP/DNS LAN que os operadores usarão para alcançar o servidor.
EDUVIGIA_WEBRTC_ADDITIONAL_HOSTS=127.0.0.1,localhost

# Lease de controle PTZ para impedir comandos concorrentes (15..120s).
EDUVIGIA_PTZ_LEASE_SECONDS=30

POSTGRES_MAX_CONNECTIONS=200
POSTGRES_LOG_MIN_DURATION_MS=1000
EDUVIGIA_DB_POOL_SIZE=10
EDUVIGIA_DB_MAX_OVERFLOW=20
EDUVIGIA_DB_POOL_TIMEOUT_SECONDS=30
EDUVIGIA_DB_POOL_RECYCLE_SECONDS=1800
EDUVIGIA_STORAGE_WARNING_PERCENT=80
EDUVIGIA_STORAGE_CRITICAL_PERCENT=95
EDUVIGIA_BACKUP_RETENTION_DAYS=30
EDUVIGIA_AUDIT_RETENTION_DAYS=365
PROMETHEUS_RETENTION_TIME=15d

# Certificados locais são gerados na implantação e nunca devem ser distribuídos no release.
EDUVIGIA_TLS_HOSTS=localhost,127.0.0.1

# F4 Playback / Evidence
EDUVIGIA_PLAYBACK_EXPORT_MAX_SECONDS=1800
EDUVIGIA_PLAYBACK_PREVIEW_MAX_SECONDS=120
EDUVIGIA_PLAYBACK_PREVIEW_TTL_SECONDS=600

# F6 Mapas Operacionais. Em produção on-prem, aponte para um tile server interno.
EDUVIGIA_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
EDUVIGIA_MAP_ATTRIBUTION=© OpenStreetMap contributors
