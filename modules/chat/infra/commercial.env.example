# EduVigIA Chat - exemplo de ambiente comercial
# NUNCA versionar o arquivo real de secrets.
# Gere valores aleatorios independentes para cada instalacao.

CHAT_POSTGRES_DB=eduvigia_chat
CHAT_POSTGRES_USER=eduvigia_chat_app
CHAT_POSTGRES_PASSWORD=<GENERATE_RANDOM_SECRET_MIN_32_CHARS>
CHAT_REDIS_PASSWORD=<GENERATE_RANDOM_SECRET_MIN_32_CHARS>

CRISIS_LIVEKIT_URL=http://livekit-crisis:17880
CRISIS_LIVEKIT_PUBLIC_URL=wss://<EDUVIGIA_HOST>:16444
CRISIS_LIVEKIT_API_KEY=<GENERATE_UNIQUE_API_KEY>
CRISIS_LIVEKIT_API_SECRET=<GENERATE_RANDOM_SECRET_MIN_48_CHARS>
CRISIS_LAN_IP=<SERVER_LAN_IP>
# Commercial identity/session authority
# Production MUST use core. standalone_qa exists only for isolated QA.
CHAT_AUTH_MODE=core
CHAT_CORE_BASE_URL=http://eduvigia-core-api:8000
CHAT_CORE_TIMEOUT_SECONDS=3
CHAT_SESSION_TTL_SECONDS=120
CHAT_WS_TICKET_TTL_SECONDS=45
